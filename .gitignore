                "Psychic": ["Delphox", "Ralts", "Kirlia", "Gardevoir", "Gallade", "Abra", "Kadabra", "Alakazam", "Espurr", "Meowstic", "Meditite", "Medicham", "Spoink", "Grumpig", "Inkay", "Malamar", "Lunatone", "Solrock", "Starmie", "Woobat", "Swoobat", "Espeon", "Sigilyph", "Chingling", "Chimecho", "Mime Jr.", "Mr. Mime", "Solosis", "Duosion", "Reuniclus", "Wynaut", "Wobbuffet", "Slowpoke", "Slowbro", "Slowking", "Exeggcute", "Exeggutor", "Smoochum", "Jynx", "Gothita", "Gothorita", "Gothitelle", "Bronzor", "Cresselia", "Wyrdeer"],
                "Bug": ["Scyther", "Heracross", "Wurmple", "Kricketot", "Sneasel", "Kleavor"],
                "Rock": ["Geodude", "Onix", "Rhyhorn", "Gligar", "Hisuian Arcanine", "Rampardos"],
                "Ghost": ["Gastly", "Drifloon", "Spiritomb", "Froslass", "Hisuian Typhlosion"],
                "Dragon": ["Gible", "Goomy", "Dratini", "Goodra (Hisuian)", "Dialga", "Palkia", "Axew", "Fraxure", "Haxorus", "Bagon", "Shelgon", "Salamence", "Dragalge", "Kingdra", "Tyrunt", "Tyrantrum", "Vibrava", "Flygon", "Gabite", "Garchomp", "Sliggoo", "Goodra", "Noibat", "Noivern", "Altaria", "Druddigon", "Deino", "Zweilous", "Hydreigon", "Dragonair", "Dragonite"],
                "Steel": ["Magnemite", "Bronzor", "Lucario", "Scizor", "Bastiodon", "Heatran"],
                "Dark": ["Murkrow", "Weavile", "Sneasel (Hisuian)", "Umbreon", "Spiritomb", "Greninja", "Crawdaunt", "Carvanha", "Sharpedo", "Pangoro", "Scraggy", "Scrafty", "Absol", "Inkay", "Malamar", "Sandile", "Krokorok", "Krookodile", "Houndour", "Houndoom", "Stunky", "Skuntank", "Sableye", "Drapion", "Purrloin", "Liepard", "Poochyena", "Mightyena", "Pawniard", "Bisharp", "Honchkrow", "Sneasel", "Tyranitar", "Zorua", "Zoroark", "Deino", "Zweilous", "Hydreigon"],
                "Fairy": ["Pichu", "Clefairy", "Togepi", "Sylveon", "Froslass", "Flabebe", "Floette", "Florges", "Togetic", "Togekiss", "Mr. Mime", "Gardevoir", "Mawile", "Azurill", "Marill", "Azumarill", "Dedenne", "Clefairy", "Clefable", "Jigglypuff", "Wigglytuff", "Snubbull", "Granbull"]
            },
        };

        const wheel = document.getElementById("inner-wheel");
        const spinButton = document.getElementById("spin");
        const resultDiv = document.getElementById("result");
        const gameButtons = document.querySelectorAll('.game-btn');
        const typeWheel = document.getElementById("type-inner-wheel");
        const spinTypeButton = document.getElementById("spin-type");
        const rouletteContainer = document.getElementById("roulette-container");
        const typeRouletteContainer = document.getElementById("type-roulette-container");
        const allPokemonRoulettesContainer = document.getElementById("all-pokemon-roulettes");


        gameButtons.forEach(gameButton => {
            gameButton.addEventListener('click', () => {
                selectedGame = gameButton.dataset.game;
                hideGameSelection();
                showRoulette();
            });
        });

        function hideGameSelection() {
            document.querySelector('h1').style.display = 'none';
            document.querySelector('.game-grid').style.display = 'none';
            document.querySelectorAll('.corner').forEach(corner => corner.style.display = 'none'); 
        }

        function showRoulette() {
            rouletteContainer.style.display = 'flex';
            resultDiv.style.display = "none"; 
            resultDiv.innerHTML = '<span></span>'; 
            hasSpun = false; 
            spinButton.onclick = spinwheel; 
            wheel.style.transition = `none`; 
            wheel.style.transform = `rotate(0deg)`; 
            rotation = 0; 
            allPokemonRoulettesContainer.style.display = 'none';
            document.querySelectorAll('.pokemon-roulette-container').forEach(container => {
                container.style.display = 'none';
            });
        }

        function spinwheel() {
            if (hasSpun) return;
            hasSpun = true;

            spinButton.onclick = null; 

            const totalSections = 4;
            const degreesPerSection = 360 / totalSections;
            const spins = Math.floor(Math.random() * 5) + 5;
            const randomExtra = Math.floor(Math.random() * 360);

            rotation += spins * 360 + randomExtra;
            wheel.style.transition = `transform 4s cubic-bezier(0.33, 1, 0.68, 1)`;
            wheel.style.transform = `rotate(${rotation}deg)`;

            setTimeout(() => {
                const normalizedAngle = (360 - (rotation % 360)) % 360;
                let selectedIndex = 0;
                if (normalizedAngle >= 0 && normalizedAngle < 90) {
                    selectedIndex = 0; 
                } else if (normalizedAngle >= 90 && normalizedAngle < 180) {
                    selectedIndex = 1; 
                } else if (normalizedAngle >= 180 && normalizedAngle < 270) {
                    selectedIndex = 2; 
                } else { 
                    selectedIndex = 3; 
                }

                const finalLabels = ["Shiny Run", "Monotype", "Nuzlocke", "Normal"];
                const resultText = "Jogo: " + selectedGame + "<br>Modo: " + finalLabels[selectedIndex];
                resultDiv.querySelector('span').innerHTML = resultText;
                resultDiv.style.display = "inline-block";

                resultDiv.querySelectorAll('.game-btn').forEach(btn => btn.remove());
                resultDiv.querySelectorAll('.go-back-btn').forEach(btn => btn.remove()); 

                if (finalLabels[selectedIndex] === "Monotype") {
                    showTypeRoulette();
                } else {
                    const playAgainButton = document.createElement('button');
                    playAgainButton.textContent = 'Jogar Novamente';
                    playAgainButton.classList.add('game-btn');
                    playAgainButton.style.marginTop = '20px';
                    playAgainButton.onclick = () => {
                        location.reload();
                    };
                    resultDiv.appendChild(playAgainButton);
                }
                spinButton.onclick = spinwheel; 
                hasSpun = false;
            }, 4000);
        }

        function showTypeRoulette() {
            rouletteContainer.style.display = 'none';
            typeRouletteContainer.style.display = 'flex';
            resultDiv.style.display = "none"; 
            resultDiv.innerHTML = '<span></span>'; 
            hasTypeSpun = false; 
            spinTypeButton.onclick = spinTypeWheel; 
            typeWheel.style.transition = `none`;
            typeWheel.style.transform = `rotate(0deg)`; 
            typeRotation = 0; 
            allPokemonRoulettesContainer.style.display = 'none';
            document.querySelectorAll('.pokemon-roulette-container').forEach(container => {
                container.style.display = 'none';
            });
        }

        function spinTypeWheel() {
            if (hasTypeSpun) return;
            hasTypeSpun = true;
            spinTypeButton.onclick = null; 

            const totalTypes = 18;
            const degreesPerType = 360 / totalTypes;
            const typeSpins = Math.floor(Math.random() * 5) + 5; 
            const typeRandomExtra = Math.floor(Math.random() * 360);

            typeRotation += typeSpins * 360 + typeRandomExtra;
            typeWheel.style.transition = `transform 4s cubic-bezier(0.33, 1, 0.68, 1)`;
            typeWheel.style.transform = `rotate(${typeRotation}deg)`;

            setTimeout(() => {
                const finalTypeAngle = typeRotation % 360;
                const normalizedAngle = (360 - (typeRotation % 360)) % 360;
                let selectedTypeIndex = 0;
                selectedTypeIndex = Math.floor(normalizedAngle / degreesPerType);

                const typeLabels = [
                    "Normal", "Rock", "Psychic", "Fire", "Grass", "Fighting", "Poison", "Flying",
                    "Water", "Bug", "Electric", "Ground", "Ice", "Steel", "Fairy", "Dragon", "Dark", "Ghost"
                ];
                const selectedType = typeLabels[selectedTypeIndex];
                const resultTypeText = "Jogo: " + selectedGame + "<br>Modo: Monotype<br>Tipo: " + selectedType;
                resultDiv.querySelector('span').innerHTML = resultTypeText;
                resultDiv.style.display = "inline-block";

                resultDiv.querySelectorAll('.game-btn').forEach(btn => btn.remove());
                resultDiv.querySelectorAll('.go-back-btn').forEach(btn => btn.remove());


                if (kalosPokemonByRegionAndType[selectedGame] && kalosPokemonByRegionAndType[selectedGame][selectedType] && kalosPokemonByRegionAndType[selectedGame][selectedType].length > 0) {
                    typeRouletteContainer.style.display = 'none'; 
                    generatePokemonTypeWheel(selectedType, kalosPokemonByRegionAndType[selectedGame][selectedType]);
                    showPokemonTypeWheel(selectedType); 
                } else {
                    resultDiv.querySelector('span').innerHTML += `<br>Não há Pokémon do tipo ${selectedType} listados para ${selectedGame}.`;

                    const backButton = document.createElement('button');
                    backButton.textContent = 'Tentar Outro Tipo';
                    backButton.classList.add('go-back-btn');
                    backButton.style.marginTop = '20px';
                    backButton.onclick = () => {
                        typeRouletteContainer.style.display = 'flex'; 
                        resultDiv.style.display = 'none'; 
                        hasTypeSpun = false; 
                        spinTypeButton.onclick = spinTypeWheel; 
                        typeWheel.style.transition = `none`; 
                        typeWheel.style.transform = `rotate(0deg)`; 
                        typeRotation = 0;
                    };
                    resultDiv.appendChild(backButton);

                    const restartGameButton = document.createElement('button');
                    restartGameButton.textContent = 'Escolher Outro Jogo';
                    restartGameButton.classList.add('game-btn');
                    restartGameButton.style.marginTop = '20px';
                    restartGameButton.style.marginLeft = '10px';
                    restartGameButton.onclick = () => {
                        location.reload(); 
                    };
                    resultDiv.appendChild(restartGameButton);

                    spinTypeButton.onclick = spinTypeWheel; 
                    hasTypeSpun = false; 
                }
            }, 4000);
        }

       
        let currentPokemonRotation = {};
        let currentPokemonSpunState = {};

        function generatePokemonTypeWheel(type, pokemonList) {
            const containerId = `pokemon-roulette-container-${type.toLowerCase().replace(/\s/g, '')}`;
            let existingContainer = document.getElementById(containerId);

            if (existingContainer) {
                existingContainer.innerHTML = '';
            } else {
                existingContainer = document.createElement('div');
                existingContainer.id = containerId;
                existingContainer.classList.add('pokemon-roulette-container');
                allPokemonRoulettesContainer.appendChild(existingContainer);
            }
            const wrapper = document.createElement('div');
            wrapper.classList.add('pokemon-wrapper');

            const arrow = document.createElement('div');
            arrow.classList.add('pokemon-arrow');

            const wheelDiv = document.createElement('div');
            wheelDiv.classList.add('pokemon-wheel');
            wheelDiv.id = `pokemon-wheel-${type.toLowerCase().replace(/\s/g, '')}`;

            const innerWheel = document.createElement('div');
            innerWheel.classList.add('pokemon-inner-wheel');
            innerWheel.id = `pokemon-inner-wheel-${type.toLowerCase().replace(/\s/g, '')}`;
            innerWheel.style.transition = `none`;
            innerWheel.style.transform = `rotate(0deg)`;

            const totalPokemon = pokemonList.length;
            const degreesPerPokemon = 360 / totalPokemon;
            let gradientString = '';
            const colors = [
                "#FF6B6B", "#42A5F5", "#66BB6A", "#FFEB3B", "#A8A878", "#B8A038", "#F85888", "#F08030",
                "#78C850", "#C03028", "#A040A0", "#A890F0", "#6890F0", "#A8B820", "#F8D030", "#E0C068",
                "#98D8D8", "#B8B8D0", "#EE99EE", "#7038F8", "#705848", "#705898"
            ];
            for (let i = 0; i < totalPokemon; i++) {
                const startAngle = i * degreesPerPokemon;
                const endAngle = (i + 1) * degreesPerPokemon;
                const colorIndex = i % colors.length;
                gradientString += `${colors[colorIndex]} ${startAngle}deg ${endAngle}deg`;
                if (i < totalPokemon - 1) {
                    gradientString += ', ';
                }
            }
            innerWheel.style.background = `conic-gradient(${gradientString})`;

            const labelContainer = document.createElement('div');
            labelContainer.classList.add('pokemon-label-container');

            pokemonList.forEach((pokemon, index) => {
                const label = document.createElement('div');
                label.classList.add('pokemon-label');
                label.textContent = pokemon;
                const angle = (index * degreesPerPokemon) + (degreesPerPokemon / 2); 
                
           
                const radius = 180; 
                const distanceFactor = 0.85;
                const labelY = -radius * distanceFactor; 
                
                label.style.transform = `rotate(${angle}deg) translateY(${labelY}px) rotate(${-angle}deg)`;
                
                let fontSize = 12;
                if (totalPokemon > 15 && totalPokemon <= 30) {
                    fontSize = 10;
                } else if (totalPokemon > 30 && totalPokemon <= 50) {
                    fontSize = 8;
                } else if (totalPokemon > 50) {
                    fontSize = 6;
                }
                label.style.fontSize = `${fontSize}px`;
                
                labelContainer.appendChild(label);
            });

            const spinButtonPokemon = document.createElement('div');
            spinButtonPokemon.classList.add('spin-pokemon');
            spinButtonPokemon.textContent = 'Girar';
            spinButtonPokemon.onclick = () => spinPokemonWheel(type, pokemonList);


            wheelDiv.appendChild(innerWheel);
            innerWheel.appendChild(labelContainer);
            wheelDiv.appendChild(spinButtonPokemon);
            wrapper.appendChild(arrow);
            wrapper.appendChild(wheelDiv);
            existingContainer.appendChild(wrapper);

            const resultPokemonDiv = document.createElement('div');
            resultPokemonDiv.id = `result-pokemon-${type.toLowerCase().replace(/\s/g, '')}`;
            resultPokemonDiv.classList.add('result-pokemon');
            resultPokemonDiv.innerHTML = `<span></span><img src="" alt="Pokémon Sprite" style="display:none;">`; // Adiciona o img
            existingContainer.appendChild(resultPokemonDiv);

            currentPokemonRotation[type] = 0;
            currentPokemonSpunState[type] = false;
        }

        function showPokemonTypeWheel(type) {
            document.querySelectorAll('.pokemon-roulette-container').forEach(container => {
                container.style.display = 'none';
            });
            allPokemonRoulettesContainer.style.display = 'flex';

            const targetPokemonRoulette = document.getElementById(`pokemon-roulette-container-${type.toLowerCase().replace(/\s/g, '')}`);
            if (targetPokemonRoulette) {
                targetPokemonRoulette.style.display = 'flex';
                resultDiv.style.display = 'none';
                const resultPokemonDiv = document.getElementById(`result-pokemon-${type.toLowerCase().replace(/\s/g, '')}`);
                if (resultPokemonDiv) {
                    resultPokemonDiv.querySelector('span').innerHTML = ''; 
                    resultPokemonDiv.querySelector('img').style.display = 'none';
                    resultPokemonDiv.querySelector('img').src = '';
                    resultPokemonDiv.style.display = 'none';
                    resultPokemonDiv.querySelectorAll('.game-btn').forEach(btn => btn.remove()); 
                    resultPokemonDiv.querySelectorAll('.go-back-btn').forEach(btn => btn.remove()); 
                }
                const spinButtonPokemon = targetPokemonRoulette.querySelector('.spin-pokemon');
                if (spinButtonPokemon) {
                    spinButtonPokemon.onclick = () => spinPokemonWheel(type, kalosPokemonByRegionAndType[selectedGame][type]);
                    currentPokemonSpunState[type] = false;
                }
            } else {
                console.error(`Container da roleta para o tipo ${type} não encontrado.`);
            }
        }

        function spinPokemonWheel(type, pokemonList) {
            if (currentPokemonSpunState[type]) return;
            currentPokemonSpunState[type] = true;

            const innerWheel = document.getElementById(`pokemon-inner-wheel-${type.toLowerCase().replace(/\s/g, '')}`);
            const spinButtonPokemon = innerWheel.parentNode.querySelector('.spin-pokemon'); // Encontrar o botão de girar específico
            spinButtonPokemon.onclick = null;

            const totalPokemon = pokemonList.length;
            const degreesPerPokemon = 360 / totalPokemon;
            const spins = Math.floor(Math.random() * 5) + 10; 
            const randomExtra = Math.floor(Math.random() * 360);

            currentPokemonRotation[type] += spins * 360 + randomExtra;
            innerWheel.style.transition = `transform 6s cubic-bezier(0.33, 1, 0.68, 1)`; 
            innerWheel.style.transform = `rotate(${currentPokemonRotation[type]}deg)`;

            setTimeout(() => {
                const finalPokemonAngle = currentPokemonRotation[type] % 360;
                const normalizedAngle = (360 - (currentPokemonRotation[type] % 360)) % 360;
                let selectedPokemonIndex = Math.floor(normalizedAngle / degreesPerPokemon);
                
                selectedPokemonIndex = Math.min(selectedPokemonIndex, totalPokemon - 1);


                const selectedPokemon = pokemonList[selectedPokemonIndex];

                const resultPokemonDiv = document.getElementById(`result-pokemon-${type.toLowerCase().replace(/\s/g, '')}`);
                
                resultPokemonDiv.querySelector('span').innerHTML = selectedPokemon;
                
                const pokemonSprite = resultPokemonDiv.querySelector('img');

                let formattedPokemonName = selectedPokemon
                    .toLowerCase()
                    .replace(/[^a-z0-9\s\-']/g, '') 
                    .replace(/\s+/g, '') 
                    .replace(/\./g, '')
                    .replace(/'/g, '')
                    .replace(/♀/g, 'f') 
                    .replace(/♂/g, 'm') 
                    .replace(/é/g, 'e') 
                    .replace(/alolan/g, '-alolan') 
                    .replace(/galarian/g, '-galarian') 
                    .replace(/hisuian/g, '-hisuian') 
                    .replace(/ /g, '-'); 

                if (formattedPokemonName.includes('-alolan')) {
                    formattedPokemonName = formattedPokemonName.replace('-alolan', '_alolan');
                } else if (formattedPokemonName.includes('-galarian')) {
                    formattedPokemonName = formattedPokemonName.replace('-galarian', '_galarian');
                } else if (formattedPokemonName.includes('-hisuian')) {
                    formattedPokemonName = formattedPokemonName.replace('-hisuian', '_hisuian');
                }
                if (formattedPokemonName === "mr.mime") { formattedPokemonName = "mr.mime"; }
                if (formattedPokemonName === "mimejr") { formattedPokemonName = "mimejr"; }
                if (formattedPokemonName === "sirfetchd") { formattedPokemonName = "sirfetchd"; }
                if (formattedPokemonName === "type:null") { formattedPokemonName = "typenull"; } 
                if (formattedPokemonName === "jangmo-o") { formattedPokemonName = "jangmo-o"; }
                if (formattedPokemonName === "kommo-o") { formattedPokemonName = "kommo-o"; }
                if (formattedPokemonName === "hakamo-o") { formattedPokemonName = "hakamo-o"; }


                const spriteUrl = `https://play.pokemonshowdown.com/sprites/gen5/${formattedPokemonName}.png`;
                
                pokemonSprite.src = spriteUrl;
                pokemonSprite.alt = selectedPokemon;
                pokemonSprite.style.display = 'block'; 
                pokemonSprite.onerror = () => {
                    const baseName = selectedPokemon.split(' ')[0].toLowerCase();
                    const fallbackSpriteUrl = `https://play.pokemonshowdown.com/sprites/gen5/${baseName}.png`;
                    pokemonSprite.src = fallbackSpriteUrl;
                    pokemonSprite.onerror = () => {
                        pokemonSprite.style.display = 'none';
                        resultPokemonDiv.querySelector('span').innerHTML += `<br>Sprite não encontrado para ${selectedPokemon}.`;
                    };
                };

                resultPokemonDiv.style.display = "flex"; 

                resultPokemonDiv.querySelectorAll('.game-btn').forEach(btn => btn.remove());
                resultPokemonDiv.querySelectorAll('.go-back-btn').forEach(btn => btn.remove()); 

                const restartButton = document.createElement('button');
                restartButton.textContent = 'Jogar Novamente';
                restartButton.classList.add('game-btn');
                restartButton.style.marginTop = '20px';
                restartButton.onclick = () => {
                    location.reload(); 
                };
                resultPokemonDiv.appendChild(restartButton);
                const backToTypeButton = document.createElement('button');
                backToTypeButton.textContent = 'Tentar Outro Tipo';
                backToTypeButton.classList.add('go-back-btn');
                backToTypeButton.style.marginTop = '20px';
                backToTypeButton.style.marginLeft = '10px';
                backToTypeButton.onclick = () => {
                    document.getElementById(`pokemon-roulette-container-${type.toLowerCase().replace(/\s/g, '')}`).style.display = 'none';
                    resultPokemonDiv.style.display = 'none';
                    showTypeRoulette(); 
                };
                resultPokemonDiv.appendChild(backToTypeButton);


                currentPokemonSpunState[type] = false;
                spinButtonPokemon.onclick = () => spinPokemonWheel(type, pokemonList); 
            }, 6000);
        }
    </script>
</body>
</html>
