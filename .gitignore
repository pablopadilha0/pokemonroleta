<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Escolha seu Jogo Pokémon</title>
    <link rel="stylesheet" href="style.css">
    <style>
        body {
            font-family: 'Press Start 2P', cursive;
            background-color: #d0f0ff;
            color: #222;
            text-align: center;
            padding: 2rem;
            position: relative;
        }

        h1 {
            font-size: 1.2rem;
            margin-bottom: 1rem;
            z-index: 1;
            position: relative;
        }

        .corner {
            position: fixed;
            width: 64px;
            height: 64px;
            image-rendering: pixelated;
            z-index: 0;
        }

        .top-left {
            top: 10px;
            left: 10px;
        }

        .top-right {
            top: 10px;
            right: 10px;
        }

        .bottom-left {
            bottom: 10px;
            left: 10px;
        }

        .bottom-right {
            bottom: 10px;
            right: 10px;
        }

        .game-grid {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 10px;
            max-width: 800px;
            margin: 0 auto;
            z-index: 1;
            position: relative;
        }

        .game-btn {
            font-family: 'Press Start 2P', cursive;
            font-size: 0.6rem;
            padding: 1rem;
            background: #ffcc00;
            color: #222;
            border: none;
            border-radius: 0.5rem;
            cursor: pointer;
            box-shadow: 0 0.25rem 0.5rem rgba(0, 0, 0, 0.2);
            transition: background 0.3s ease, transform 0.2s ease;
        }

        .game-btn:hover {
            background: #ffb800;
            transform: translateY(-0.1rem);
        }

        .game-btn:active {
            background: #ff9e00;
            transform: translateY(0);
            box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.2);
        }

        #roulette-container {
            display: none;
            margin-top: 2rem;
            align-items: center;
            flex-direction: column;
            width: fit-content;
            position: relative;
            z-index: 2;
        }

        #wrapper {
            position: relative;
            width: 400px;
            height: 400px;
        }

        .arrow {
            position: absolute;
            right: -70px;
            top: 50%;
            transform: translateY(-50%);
            width: 0;
            height: 0;
            border-top: 20px solid transparent;
            border-bottom: 20px solid transparent;
            border-right: 30px solid #222; 
            z-index: 10;
        }

        #wheel {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            border: 10px solid #333;
            position: relative;
            overflow: hidden;
            background: #333;
        }

        .inner-wheel {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            transform: rotate(0deg);
            transition: transform 4s cubic-bezier(0.33, 1, 0.68, 1);
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            background: conic-gradient(
                #ff6b6b 0deg 90deg,
                #42a5f5 90deg 180deg,
                #66bb6a 180deg 270deg,
                #ffeb3b 270deg 360deg
            );
        }

        .label-container {
            position: absolute;
            width: 100%;
            height: 100%;
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            pointer-events: none;
        }

        .label {
            position: absolute;
            transform-origin: center center;
            color: #fff;
            font-weight: bold;
            font-size: 18px;
            text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8);
        }

        .label:nth-child(1) { transform: rotate(45deg) translateY(-160px); } /* Shiny Run */
        .label:nth-child(2) { transform: rotate(135deg) translateY(-160px); } /* Monotype */
        .label:nth-child(3) { transform: rotate(225deg) translateY(-160px); } /* Nuzlocke */
        .label:nth-child(4) { transform: rotate(315deg) translateY(-160px); } /* Normal */


        #spin {
            position: absolute;
            width: 120px;
            height: 120px;
            background: #fff;
            color: #333;
            font-weight: bold;
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            cursor: pointer;
            z-index: 5;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.5);
            font-size: 24px;
            border: 4px solid #333;
        }

        #spin:hover {
            background: #eee;
        }

        #result {
            margin-top: 30px;
            font-size: 2em;
            font-weight: bold;
            color: #333;
            text-align: center;
            font-family: 'Press Start 2P', monospace;
            padding: 10px 20px;
            border: 4px solid #333;
            border-radius: 10px;
            background-color: #fff;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.5);
            display: none;
            letter-spacing: 2px;
            position: relative;
            overflow: visible;
            margin-top: 2rem;
            width: fit-content;
        }

        #type-roulette-container {
            display: none;
            margin-top: 2rem;
            align-items: center;
            flex-direction: column;
            width: fit-content;
            position: relative;
            z-index: 3;
        }

        #type-wrapper {
            position: relative;
            width: 400px;
            height: 400px;
        }

        .type-arrow {
            position: absolute;
            right: -25px;
            top: 50%;
            transform: translateY(-50%);
            width: 0;
            height: 0;
            border-top: 20px solid transparent;
            border-bottom: 20px solid transparent;
            border-left: 30px solid #333;
            z-index: 10;
        }

        #type-wheel {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            border: 10px solid #333;
            position: relative;
            overflow: hidden;
            background: #333;
        }

        .type-inner-wheel {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            transform: rotate(0deg);
            transition: transform 4s cubic-bezier(0.33, 1, 0.68, 1);
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            background: conic-gradient(
                #a8a878 0deg 20deg,  /* Normal     */
                #b8a038 20deg 40deg,  /* Rock       */
                #f85888 40deg 60deg,  /* Psychic    */
                #f08030 60deg 80deg,  /* Fire       */
                #78c850 80deg 100deg, /* Grass      */
                #c03028 100deg 120deg, /* Fighting   */
                #a040a0 120deg 140deg, /* Poison     */
                #a890f0 140deg 160deg, /* Flying     */
                #6890f0 160deg 180deg, /* Water      */
                #a8b820 180deg 200deg, /* Bug        */
                #f8d030 200deg 220deg, /* Electric   */
                #e0c068 220deg 240deg, /* Ground     */
                #98d8d8 240deg 260deg, /* Ice       */
                #b8b8d0 260deg 280deg, /* Steel      */
                #ee99ee 280deg 300deg, /* Fairy      */
                #7038f8 300deg 320deg, /* Dragon     */
                #705848 320deg 340deg, /* Dark       */
                #705898 340deg 360deg  /* Ghost      */
            );
        }

        .type-label-container {
            position: absolute;
            width: 100%;
            height: 100%;
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            pointer-events: none;
        }

        .type-label {
            position: absolute;
            transform-origin: center center;
            color: #fff;
            font-weight: bold;
            font-size: 12px;
            text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8);
        }
        .type-label:nth-child(1) { transform: rotate(10deg) translateY(-180px); } 
        .type-label:nth-child(2) { transform: rotate(30deg) translateY(-180px); } 
        .type-label:nth-child(3) { transform: rotate(50deg) translateY(-180px); } 
        .type-label:nth-child(4) { transform: rotate(70deg) translateY(-180px); } 
        .type-label:nth-child(5) { transform: rotate(90deg) translateY(-180px); } 
        .type-label:nth-child(6) { transform: rotate(110deg) translateY(-180px); } 
        .type-label:nth-child(7) { transform: rotate(130deg) translateY(-180px); } 
        .type-label:nth-child(8) { transform: rotate(150deg) translateY(-180px); } 
        .type-label:nth-child(9) { transform: rotate(170deg) translateY(-180px); } 
        .type-label:nth-child(10){ transform: rotate(190deg) translateY(-180px); } 
        .type-label:nth-child(11){ transform: rotate(210deg) translateY(-180px); } 
        .type-label:nth-child(12){ transform: rotate(230deg) translateY(-180px); } 
        .type-label:nth-child(13){ transform: rotate(250deg) translateY(-180px); } 
        .type-label:nth-child(14){ transform: rotate(270deg) translateY(-180px); } 
        .type-label:nth-child(15){ transform: rotate(290deg) translateY(-180px); } 
        .type-label:nth-child(16){ transform: rotate(310deg) translateY(-180px); } 
        .type-label:nth-child(17){ transform: rotate(330deg) translateY(-180px); } 
        .type-label:nth-child(18){ transform: rotate(350deg) translateY(-180px); } 


        #spin-type {
            position: absolute;
            width: 120px;
            height: 120px;
            background: #fff;
            color: #333;
            font-weight: bold;
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            cursor: pointer;
            z-index: 5;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.5);
            font-size: 24px;
            border: 4px solid #333;
        }

        #spin-type:hover {
            background: #eee;
        }

        .pokemon-roulette-container {
            display: flex;
            margin-top: 2rem;
            align-items: center;
            flex-direction: column;
            width: fit-content;
            position: relative;
            z-index: 4; 
        }

        .pokemon-wrapper {
            position: relative;
            width: 400px;
            height: 400px;
        }

        .pokemon-arrow {
            position: absolute;
            right: -25px;
            top: 50%;
            transform: translateY(-50%);
            width: 0;
            height: 0;
            border-top: 20px solid transparent;
            border-bottom: 20px solid transparent;
            border-left: 30px solid #333;
            z-index: 10;
        }

        .pokemon-wheel {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            border: 10px solid #333;
            position: relative;
            overflow: hidden;
            background: #333; /* Cor de fundo padrão */
        }

        .pokemon-inner-wheel {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            transform: rotate(0deg);
            transition: transform 4s cubic-bezier(0.33, 1, 0.68, 1);
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
        }

        .pokemon-label-container {
            position: absolute;
            width: 100%;
            height: 100%;
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            pointer-events: none;
        }

        .pokemon-label {
            position: absolute;
            transform-origin: center center;
            color: #fff;
            font-weight: bold;
            font-size: 12px; 
            text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8);
            white-space: nowrap; 
            text-overflow: ellipsis; 
            overflow: hidden; 
            max-width: 90%; 
        }

        .spin-pokemon {
            position: absolute;
            width: 120px;
            height: 120px;
            background: #fff;
            color: #333;
            font-weight: bold;
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            cursor: pointer;
            z-index: 5;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.5);
            font-size: 24px;
            border: 4px solid #333;
        }

        .spin-pokemon:hover {
            background: #eee;
        }

        .result-pokemon {
            margin-top: 30px;
            font-size: 2em;
            font-weight: bold;
            color: #333;
            text-align: center;
            font-family: 'Press Start 2P', monospace;
            padding: 10px 20px;
            border: 4px solid #333;
            border-radius: 10px;
            background-color: #fff;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.5);
            display: none;
            letter-spacing: 2px;
            position: relative;
            overflow: visible;
            width: fit-content;
            display: flex; 
            flex-direction: column; 
            align-items: center; 
        }

        .result-pokemon img {
            margin-top: 10px;
            image-rendering: pixelated; 
            width: 96px; 
            height: 96px;
        }

        .go-back-btn {
            font-family: 'Press Start 2P', cursive;
            font-size: 0.6rem;
            padding: 1rem;
            background: #007bff;
            color: #fff;
            border: none;
            border-radius: 0.5rem;
            cursor: pointer;
            box-shadow: 0 0.25rem 0.5rem rgba(0, 0, 0, 0.2);
            transition: background 0.3s ease, transform 0.2s ease;
            margin-top: 20px;
        }

        .go-back-btn:hover {
            background: #0056b3;
            transform: translateY(-0.1rem);
        }

        @import url('https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap');

    </style>
</head>
<body>
    <h1>Escolha seu Jogo Pokémon</h1>
    <img src="https://play.pokemonshowdown.com/sprites/gen5/dragapult.png" alt="Dragapult" class="corner top-left">
    <img src="https://play.pokemonshowdown.com/sprites/gen5/dragonite.png" alt="Dragonite" class="corner top-right">
    <img src="https://play.pokemonshowdown.com/sprites/gen5/gengar.png" alt="Gengar" class="corner bottom-left">
    <img src="https://play.pokemonshowdown.com/sprites/gen5/charizard.png" alt="Charizard" class="corner bottom-right">
    <div class="game-grid">
        <button class="game-btn" data-game="Pokémon X">Pokémon X</button>
        <button class="game-btn" data-game="Pokémon Y">Pokémon Y</button>
        <button class="game-btn" data-game="Pokémon Omega Ruby">Pokémon Omega Ruby</button>
        <button class="game-btn" data-game="Pokémon Alpha Sapphire">Pokémon Alpha Sapphire</button>
        <button class="game-btn" data-game="Pokémon Moon">Pokémon Moon</button>
        <button class="game-btn" data-game="Pokémon Sun">Pokémon Sun</button>
        <button class="game-btn" data-game="Pokémon Sword">Pokémon Sword</button>
        <button class="game-btn" data-game="Pokémon Scarlet">Pokémon Scarlet</button>
        <button class="game-btn" data-game="Pokémon Violet">Pokémon Violet</button>
        <button class="game-btn" data-game="Pokémon Legends: Arceus">Pokémon Legends: Arceus</button>
    </div>

    <div id="roulette-container">
        <div id="wrapper">
            <div class="arrow"></div>
            <div id="wheel">
                <div class="inner-wheel" id="inner-wheel">
                    <div class="label-container">
                        <div class="label">Shiny Run</div>
                        <div class="label">Monotype</div>
                        <div class="label">Nuzlocke</div>
                        <div class="label">Normal</div>
                    </div>
                </div>
                <div id="spin" onclick="spinwheel()">Girar</div>
            </div>
        </div>
        <div id="result">
            <span></span>
        </div>
    </div>

    <div id="type-roulette-container">
        <div id="type-wrapper">
            <div class="type-arrow"></div>
            <div id="type-wheel">
                <div class="type-inner-wheel" id="type-inner-wheel">
                    <div class="type-label-container">
                        <div class="type-label">Normal</div>
                        <div class="type-label">Rock</div>
                        <div class="type-label">Psychic</div>
                        <div class="type-label">Fire</div>
                        <div class="type-label">Grass</div>
                        <div class="type-label">Fighting</div>
                        <div class="type-label">Poison</div>
                        <div class="type-label">Flying</div>
                        <div class="type-label">Water</div>
                        <div class="type-label">Bug</div>
                        <div class="type-label">Electric</div>
                        <div class="type-label">Ground</div>
                        <div class="type-label">Ice</div>
                        <div class="type-label">Steel</div>
                        <div class="type-label">Fairy</div>
                        <div class="type-label">Dragon</div>
                        <div class="type-label">Dark</div>
                        <div class="type-label">Ghost</div>
                    </div>
                </div>
                <div id="spin-type" onclick="spinTypeWheel()">Girar</div>
            </div>
        </div>
        </div>

    <div id="all-pokemon-roulettes" style="display: none; flex-direction: column; align-items: center; margin-top: 2rem;">
        </div>

    <script>
        let selectedGame = '';
        let rotation = 0;
        let hasSpun = false;
        let typeRotation = 0;
        let hasTypeSpun = false;

        const kalosPokemonByRegionAndType = {
            "Pokémon X": {
                "Normal": ["Bunnelby","Diggersby","Zigzagoon","Linoone", "Fletchling","Fletchinder","Talonflame","Pidgey","Pidgeotto","Pidgeot","Bidoof" ,"Bibarel","Dunsparce","Azurill","Litleo","Pyroar","Farfetch'd","Skitty","Delcatty","Furfrou","Doduo","Dodrio","Sentret","Furret","Kecleon","Munchlax", "Whismur","Loudred","Exploud", "Kangaskhan", "Eevee", "Snorlax", "Ditto", "Smeargle", "Audino"],
                "Fire": ["Fennekin","Braixen","Delphox","Litleo","Pyroar", "Fletchinder","Talonflame","Pansear","Simisear", "Charmander","Charmeleon","Charizard", "Houndour","Houndoom","Flareon","Slugma","Magcargo", "Litwick", "Lampeant","Chandelure", "Torkoal", "Heatmor"],
                "Water": ["Froakie","Frogadier","Greninja","Panpour","Simipour","Bibarel","Surskit","Corphish","Crawdant","Goldeen","Seaking","Carvanha","Sharpedo","Psyduck","Golduck", "Squirtle","Wartotle","Blastoise","Duckett","Swanna","Wingull","Pelipper","Binacle","Barbaracle","Tentacool","Tentacruel","Waimer","Wailord","Luvidisc", "Clauncher","Clawitzer", "Skrelp", "Marill","Azumarill", "Staryu","Starmie", "Sheldder","Cloyster","Qwilfish","Horsea","Seadra","Kingdra","Relicanth","Vaporeon","Slowpoke","Slowbro","Slowking","Mantyke","Mantine","Clampearl","Huntail","Gorebyss","Remoraid","Octillery","Corsola","Chinchou","Lanturn","Alomomola", "Lapras", "Magikarp","Gyarados","Poliwag","Poliwhirl","Poliwrath","Politoed","Barboach","Whiscash","Lotad","Lombre","Ludicolo","Buizel","Floatzel","Basculin"],
                "Grass": ["Chespin","Quiladin","Chesnaught","Pansage","Simisage","Wormadam","Budew","Roselia","Roserade","Skiddo","Gogoat", "Pansage", "Bulbasaur","Ivysaur","Venusaur","Oddish","Gloom","Vileplume","Bellossom","Hoppip","Skiploom","Jumpluff","Ferroseed","Ferrothorn","Leafeon","Exeggcute","Exeggutor", "Bellsprout","Weepinbell","Victreebel","Carnivine","Foongus","Amoonguss","Lotad","Lombre","Ludicolo","Trevenant","Pumpkaboo","Gourgeist","Snover","Abomasnow","Phantump"],
                "Electric": ["Pichu","Pikachu", "Raichu","Minum", "Plusle","Helioptile","Heliolisk","Electrike", "Manectric","Jolteon", "Emolga", "Dedenne","Mareep","Flaaffy","Ampharos","Stunfisk","Voltorb","Electrode", "Magnemite", "Magneton", "Magnezone", "Pachirisu", "Chinchou", "Lanturn", "Rotom"],
                "Ice": ["Bergmite", "Cryogonal", "Snover", "Swinub", "Lapras", "Vanillite", "Vanillish", "Vanilluxe", "Spheal", "Sealeo", "Walrein", "Piloswine", "Mamoswine", "Smoochum", "Jynx", "Delibird", "Abomasnow", "Sneasel", "Weavile"],
                "Fighting": ["Pancham", "Hawlucha", "Mienfoo", "Riolu", "Scraggy", "Machop", "Machoke", "Machamp", "Mankey", "Primeape", "Tyrogue", "Hitmonlee", "Hitmonchan", "Hitmontop", "Meditite", "Medicham", "Scrafty", "Heracross", "Lucario", "Pangoro", "Breloom", "Gurdurr", "Conkeldurr"],
                "Poison": ["Wedlee","Kakuna","Beedrill","Budew","Roselia","Roserade","Bulbasaur","Ivysaur","Venusaur","Gulpin","Swalot","Skrelp", "Croagunk", "Trubbish", "Nidoran♀", "Zubat", "Oddish","Gloom","Vileplume","Venipede","Whirlipede","Scolipede","Toxicroak","Crobat","Golbat","Seviper","Tentacool","Tentacruel","Dragalge","Qwilfish","Stunky","Skuntank","Nidoran","Nidorina","Nidoqueen","Nidoran","Nidorino","Nidoking","Skorupi","Drapion","Gastly","Haunter","Gengar","Bellsprout","Weepinbell","Victreebel","Ekans","Arbok","Foongus","Amoonguss","Trubbish","Garbodor","Spinarak","Ariados"],
                "Ground": ["Diggersby","Nincada","Sandile","Krokorok","Krookodile","Hippopotas","Hippowdon","Sandshrew", "Rhyhorn","Rhydon","Rhyperior","Onix","Steelix","Cubone","Marowak","Trapinch","Vibrava","Flygon", "Gible","Gabite","Garchoomp", "Golett","Golurk","Nidoqueen","Nidoking","Diglett","Dugtrio","Geodude","Graveler","Golem","Wooper","Stunfisk","Barboach","Whiscash","Swinub","Piloswine","Mamoswine","Sandshrew","Sandslash","Larvitar","Pupitar","Gligar","Gliscor"],
